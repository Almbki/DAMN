# Frontend runtime config. EXPO_PUBLIC_* values are inlined at build time,
# so restart the dev server with --clear after changing anything here.

# FastAPI backend base URL (no trailing slash, no /api/v1 here).
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8000

# 'mock' (no backend needed) or 'api'.
EXPO_PUBLIC_DATA_SOURCE=api

# --- Demo auto-login (optional) -------------------------------------------
# Enabled ONLY when both values are non-empty. Leave both blank for normal
# Login/Register. These values are PUBLIC in an Expo web bundle; never use a
# privileged or real-user account.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=

# --- Public demo credentials for this repository's local demo --------------
# Uncomment both to auto-login the demo account (normal JWT login, no bypass).
# EXPO_PUBLIC_DEMO_EMAIL=demo@damn.app
# EXPO_PUBLIC_DEMO_PASSWORD=password123
