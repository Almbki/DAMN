# ---------------------------------------------------------------------------
# AI Adaptive Task Planner - environment template
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="AI Adaptive Task Planner"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Comma separated list. Use `*` to allow all (development only).
CORS_ORIGINS=*

# --- Database --------------------------------------------------------------
# Local development (default, zero setup):
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL (docker-compose / production):
# DATABASE_URL=postgresql+psycopg://planner:planner@localhost:5432/planner
DB_ECHO=false

# --- Auth / JWT ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider ----------------------------------------------------------
# First version ships a deterministic MockLLMClient. Swap provider to
# `openai_compatible` and fill the values below to use a real model.
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_TIMEOUT_SECONDS=30

# --- Scheduler / Rule engine defaults -------------------------------------
SCHEDULER_DAILY_LIMIT_MINUTES=300
SCHEDULER_BUFFER_MINUTES=15
SCHEDULER_HIGH_COGNITIVE_MAX_PER_DAY=2
SCHEDULER_MIN_REPLAN_INTERVAL_HOURS=24

# --- SSE / generation jobs -------------------------------------------------
GENERATION_JOB_TTL_SECONDS=1800
